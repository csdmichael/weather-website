{
  "name": "server",
  "private": true,
  "version": "1.0.0",
  "description": "REST API serving average weather data by US State",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"const fs=require('fs');fs.rmSync('dist/public',{recursive:true,force:true});if(fs.existsSync('../client/dist')){fs.cpSync('../client/dist','dist/public',{recursive:true});}\"",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.1.11"
  }
}
